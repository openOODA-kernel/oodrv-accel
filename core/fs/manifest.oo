// # oodrv-accel FsReadCap Manifest Reader
//
// Logline: Read a real accelerator manifest file under FsReadCap and decode each command-queue descriptor record.
// Setup: Declared cap: FsReadCap. Path/read probes only; bad inputs fail closed (codes 20-23).
// Beats:
//   1. Publish the loader fail-closed codes for missing paths, unreadable files, rejected records, and refused paths.
//   2. Parse each non-blank manifest line as five integers and validate via accel_record_parse.
//   3. Collect the decoded records and return the loaded manifest with its record count.

import "oostd/fs/os/fs.oo";
import "core/engine.oo";
import "core/fs/gate.oo";

type AccelManifest = struct {
    records: List[AccelDrvContext],
    count: Int,
    code: Int
};

pub fn accel_code_missing_path() -> Int { return 20; }
pub fn accel_code_unreadable() -> Int { return 21; }
pub fn accel_code_bad_record() -> Int { return 22; }
pub fn accel_code_refused() -> Int { return 23; }

pub fn accel_manifest_digit(ch: String) -> Int {
    if ch == "0" { return 0; }
    if ch == "1" { return 1; }
    if ch == "2" { return 2; }
    if ch == "3" { return 3; }
    if ch == "4" { return 4; }
    if ch == "5" { return 5; }
    if ch == "6" { return 6; }
    if ch == "7" { return 7; }
    if ch == "8" { return 8; }
    if ch == "9" { return 9; }
    return -1;
}

pub fn accel_manifest_int(s: String) -> Int {
    let n: Int = chars_len(s);
    if n == 0 || n > 9 { return -1; }
    let mut v: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let d: Int = accel_manifest_digit(char_at(s, i));
        if d < 0 { return -1; }
        v = (v * 10) + d;
        i = i + 1;
    }
    return v;
}

pub fn accel_manifest_line(line: String) -> AccelDrvContext {
    let raw: List[String] = str_split(line, " ");
    let mut vals: List[Int] = list_new();
    let mut bad: Bool = false;
    let mut i: Int = 0;
    while i < list_len(raw) {
        let tk: String = list_get(raw, i);
        if chars_len(tk) > 0 {
            let v: Int = accel_manifest_int(tk);
            if v < 0 { bad = true; }
            vals = list_push(vals, v);
        }
        i = i + 1;
    }
    if bad || list_len(vals) != 5 {
        return accel_record_parse(0, 0, 0, 0, 0);
    }
    return accel_record_parse(list_get(vals, 0), list_get(vals, 1), list_get(vals, 2), list_get(vals, 3),
        list_get(vals, 4));
}

pub fn accel_manifest_load(fs_r: &FsReadCap, path: String) -> AccelManifest {
    let blank: List[AccelDrvContext] = list_new();
    if oodrv_accel_path_refused(path) {
        return AccelManifest { records: blank, count: 0, code: accel_code_refused() };
    }
    if chars_len(path) == 0 || fs_path_exists(fs_r, path) == false {
        return AccelManifest { records: blank, count: 0, code: accel_code_missing_path() };
    }
    let rd: Result[String, String] = fs_read_file(fs_r, path);
    if rd.is_err() {
        return AccelManifest { records: blank, count: 0, code: accel_code_unreadable() };
    }
    let content: String = match rd { Ok(s) => s, Err(_) => "" };
    let lines: List[String] = str_split(content, "\n");
    let mut recs: List[AccelDrvContext] = list_new();
    let mut i: Int = 0;
    while i < list_len(lines) {
        let line: String = list_get(lines, i);
        if chars_len(line) > 0 {
            let fr: AccelDrvContext = accel_manifest_line(line);
            if fr.is_ready == false {
                return AccelManifest { records: recs, count: list_len(recs), code: accel_code_bad_record() };
            }
            recs = list_push(recs, fr);
        }
        i = i + 1;
    }
    return AccelManifest { records: recs, count: list_len(recs), code: 0 };
}
