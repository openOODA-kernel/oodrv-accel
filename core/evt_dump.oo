// # oodrv-accel Non-Fatal Subsystem Dump & Hot-Restart
//
// Logline: Snapshot faulted accelerator queues into a copy-on-write event dump and
//   hot-restart the command ring without a kernel panic.
//
// Setup: Pure deterministic event-dump recovery engine sealed with std/sec/capreg.oo and oo_pqc_sha3_round.
//
// Beats:
//   1. Require SysCap (4), ArenaCap (9), and MetricsCap (11) in the caller's 64-bit CapReg64 register via oo_cap_reg64_check.
//   2. Capture the faulted GPU/NPU/CXL/QAT ring pages into an isolated CoW live dump snapshot without halting unaffected CPUs.
//   3. Reset and re-admit the accelerator queue in-place and seal the recovery event with oo_pqc_sha3_round.

import "oostd/sec/pqc.oo";
import "oostd/sec/capreg.oo";

type AccelEvtRecovery = struct {
    bugcheck_avoided: Bool,
    dumped_pages: Int,
    hot_restarted: Bool,
    cap_reg64: Int,
    admitted: Bool,
    digest: Int
};

pub fn accel_evtdump_req_caps() -> Int {
    return (1 << oo_cap_bit_index("SysCap")) | (1 << oo_cap_bit_index("ArenaCap")) | (1 << oo_cap_bit_index("MetricsCap"));
}

pub fn accel_evtdump_recover(epoch: Int, reg64: Int, fault_code: Int, ring_pages: Int) -> AccelEvtRecovery {
    let req: Int = accel_evtdump_req_caps();
    if oo_cap_reg64_check(reg64, epoch, 3, req) == false || fault_code <= 0 || ring_pages <= 0 {
        return AccelEvtRecovery { bugcheck_avoided: false, dumped_pages: 0, hot_restarted: false, cap_reg64: 0,
            admitted: false, digest: 0 };
    }
    let dig: Int = oo_pqc_sha3_round(oo_pqc_sha3_round(reg64, fault_code), ring_pages + epoch);
    return AccelEvtRecovery { bugcheck_avoided: true, dumped_pages: ring_pages, hot_restarted: true, cap_reg64: reg64,
        admitted: true, digest: dig };
}
